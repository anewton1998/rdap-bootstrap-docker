# --- Rust build artifacts ---
/target
**/target
# rustfmt / backup files
**/*.rs.bk
# debug symbols
**/*.pdb

# Cargo.lock is intentionally NOT ignored: rdap-tld-redirect-gen is a binary
# tool and committing the lockfile keeps its (git-pinned) dependency graph
# reproducible.

# --- Generated redirect data ---
# The rdap-tld-redirect-gen output (tld_redirect_*.template + __default.help) is
# committed so the Docker image can bake it in. The server's runtime bootstrap
# cache (bootstrap_*, *.iana_cache, reload) written into ./data when a container
# mounts it stays ignored.
/data/*
!/data/tld_redirect_*.template
!/data/__default.help

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs / scratch ---
*.log
scratch/
